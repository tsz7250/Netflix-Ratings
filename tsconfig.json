{
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "./node_modules"
  ],
  "compilerOptions": {
    "target": "ES2016",
    "lib": [
      "DOM",
      "ES2016"
    ],
    "module": "ES6",
    "rootDir": "src",
    "moduleResolution": "node",
    "types": [
      "chrome"
    ],
    "outDir": "./build",
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  }
}
